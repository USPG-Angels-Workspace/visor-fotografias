<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Visor de fotografías</title>
    <style>
        body { font-family: system-ui, sans-serif; margin: 0; background: #f4f5f7; color: #222; }
        nav { background: #1f2a44; padding: .8rem 1.5rem; display: flex; gap: 1.2rem; align-items: center; }
        nav a { color: #fff; text-decoration: none; }
        nav a:hover { text-decoration: underline; }
        nav .marca { font-weight: bold; margin-right: auto; }
        main { max-width: 960px; margin: 1.5rem auto; padding: 0 1rem; }
        .tarjeta { background: #fff; border-radius: 8px; padding: 1.2rem; box-shadow: 0 1px 4px #0002; margin-bottom: 1rem; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: .5rem; border-bottom: 1px solid #ddd; text-align: left; }
        .btn { display: inline-block; background: #2f6fed; color: #fff; border: 0; border-radius: 5px; padding: .45rem .9rem; text-decoration: none; cursor: pointer; font-size: .95rem; }
        .btn.sec { background: #6b7280; }
        .btn.rojo { background: #c0392b; }
        .btn[aria-disabled=true] { opacity: .4; pointer-events: none; }
        input[type=text] { padding: .4rem; width: 20rem; max-width: 100%; }
        .msg { padding: .6rem 1rem; border-radius: 5px; margin-bottom: 1rem; background: #e6f4ea; }
        .msg.error { background: #fdecea; }
        .visor img { max-width: 100%; max-height: 60vh; display: block; margin: 0 auto 1rem; border-radius: 6px; }
        .visor .acciones { display: flex; justify-content: space-between; align-items: center; }
        form.inline { display: inline; }
    </style>
</head>
<body>
    <nav>
        <span class="marca">📷 Visor de fotografías</span>
        <a asp-controller="Fotos" asp-action="Index">Lista</a>
        <a asp-controller="Fotos" asp-action="Visor">Visor</a>
        <a asp-controller="Fotos" asp-action="Insertar">Insertar</a>
        <a asp-controller="Fotos" asp-action="Buscar">Buscar</a>
    </nav>
    <main>
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="msg @(TempData["Error"] is true ? "error" : "")">@mensaje</div>
        }
        @RenderBody()
    </main>
</body>
</html>
