@{
    ViewData["Title"] = "Insertar";
}
<div class="tarjeta">
    <h2>Insertar fotografía</h2>
    <p>Sube una imagen, o escribe el nombre de una que ya esté en <code>wwwroot/fotos</code>.</p>
    <form method="post" enctype="multipart/form-data">
        <p><input type="file" name="archivo" accept=".jpg,.jpeg,.png,.gif,.webp,.svg,image/*" /></p>
        <p>o nombre existente: <input type="text" name="nombre" placeholder="ej. playa.svg" /></p>
        <p>
            <label><input type="radio" name="posicion" value="inicio" /> Al inicio</label>
            <label><input type="radio" name="posicion" value="final" checked /> Al final</label>
        </p>
        <button class="btn" type="submit">Insertar</button>
    </form>
</div>
